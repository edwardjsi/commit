{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAppBucketCRUD",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::myapp-dev-bucket",
        "arn:aws:s3:::myapp-dev-bucket/app/*"
      ]
    }
  ]
}
